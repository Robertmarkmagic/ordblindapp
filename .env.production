# Public build settings for the current invited-tester phase.
# This file contains no keys or credentials.
VITE_TESTER_MODE=true
VITE_BILLING_PROVIDER=none

# OverSkill app identity from the ReliefRead data export. Required for the
# standalone login flow used by reliefread.com.
VITE_APP_ID=13957
VITE_APP_VISIBILITY=login_required
VITE_PLATFORM_URL=https://www.overskill.com
VITE_POST_LOGIN_ROUTE=/dashboard
