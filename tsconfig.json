{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": [
    "src/assetResolver.d.ts",
    "src/assetResolver.js",
    "src/components/AppBrand.tsx",
    "src/components/CheckoutDialog.tsx",
    "src/components/LazyImage.tsx",
    "src/components/OptimizedImage.tsx",
    "src/components/PushHealthBanner.tsx",
    "src/components/RequireRole.tsx",
    "src/consoleLogger.js",
    "src/hooks/use-roles.ts",
    "src/hooks/useAiAudio.ts",
    "src/hooks/useAiVideo.ts",
    "src/hooks/useAsset.ts",
    "src/hooks/useCheckoutSession.ts",
    "src/hooks/useWalletBalance.ts",
    "src/lib/analytics.ts",
    "src/lib/composio.ts",
    "src/lib/error-reporter.ts",
    "src/lib/fetch-interceptor.ts",
    "src/lib/funnel-context.tsx",
    "src/lib/integry.ts",
    "src/lib/lazyLoad.ts",
    "src/lib/preview-auth.ts",
    "src/lib/theme-preview.ts",
    "src/lib/whop.ts",
    "src/routes/access-denied.tsx",
    "src/routes/checkout-complete.tsx",
    "src/worker.js"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
