# Browser-safe Supabase connection values.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Invited testers receive every feature without payment while this is true.
VITE_TESTER_MODE=true
VITE_BILLING_PROVIDER=none

# Stripe browser-safe configuration for the paid launch.
# Secret keys and webhook secrets belong in Supabase Edge Function secrets.
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_PRICE_PREMIUM_MONTHLY=
VITE_STRIPE_PRICE_PREMIUM_ANNUAL=
VITE_STRIPE_CHECKOUT_ENDPOINT=
