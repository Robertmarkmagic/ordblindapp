VITE_APP_ID=
VITE_OWNER_ID=
VITE_ENVIRONMENT=development
VITE_APP_NAME=ReliefRead
VITE_APP_VISIBILITY=public
VITE_PLATFORM_URL=https://www.overskill.com
VITE_POST_LOGIN_ROUTE=/dashboard

# Tester rollout. Keep true while invited testers should receive all features
# without payment. Set to false before the paid public launch.
VITE_TESTER_MODE=true

# Billing provider: none during testing, stripe for the paid production launch.
VITE_BILLING_PROVIDER=none

# Stripe browser-safe configuration. Do not add Stripe secret keys or webhook
# secrets to this file, GitHub Pages, or any other frontend environment.
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_PRICE_PREMIUM_MONTHLY=
VITE_STRIPE_PRICE_PREMIUM_ANNUAL=
VITE_STRIPE_CHECKOUT_ENDPOINT=

# Legacy optional paid-plan ids from OverSkill Payments / Whop.
VITE_PLAN_PREMIUM_MONTHLY=
VITE_PLAN_PREMIUM_ANNUAL=

# Optional OAuth setting for standalone login flows.
VITE_OAUTH_CLIENT_ID=
